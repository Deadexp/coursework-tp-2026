{
  "permissions": {
    "allow": [
      "Bash(docker compose *)",
      "Bash(npm run *)",
      "Bash(npm install*)",
      "Bash(pytest*)",
      "Bash(ruff *)",
      "Bash(alembic *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(docker compose down -v*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
