# Скопируйте в .env и заполните. .env не коммитится.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=english
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/english

# Подпись токенов входа. В проде — длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-secret-change-me-in-production

# Telegram
BOT_TOKEN=
API_BASE_URL=http://api:8000
BOT_SERVICE_TOKEN=change-me   # бот авторизуется в API этим токеном

# DeepSeek через OpenRouter. Для разработки без модели задайте LLM_PROVIDER=stub.
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017
LLM_EFFORT=low

# Shared vocabulary: public bot username (without @), website URL and backend address.
# BOT_SERVICE_TOKEN must be the same random secret on backend and bot (at least 32 characters).
BOT_USERNAME=
WEBSITE_URL=http://localhost:5173
