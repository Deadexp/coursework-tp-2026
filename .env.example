# Скопируйте в .env и заполните. .env не коммитится.
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=english
DATABASE_URL=postgresql+asyncpg://app:app@db:5432/english

# Подпись токенов входа. В проде — длинная случайная строка: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-secret-change-me-in-production

# Telegram
BOT_TOKEN=
API_BASE_URL=http://api:8000
BOT_SERVICE_TOKEN=change-me   # бот авторизуется в API этим токеном

# LLM (Claude). Без ключа работает заглушка: LLM_PROVIDER=stub
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_EFFORT=low
